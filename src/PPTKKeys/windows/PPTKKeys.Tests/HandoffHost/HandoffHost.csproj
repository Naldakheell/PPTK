<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only process for the handoff protocol tests: no keyboard hook (a fake that logs install/remove),
       test mutex and event names only. Never used by the helper. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\HelperHandoff.cs" Link="HelperHandoff.cs" />
    <Compile Include="..\..\HelperWiring.cs" Link="HelperWiring.cs" />
    <Compile Include="..\..\LiveDeployment.cs" Link="LiveDeployment.cs" />
    <Compile Include="..\..\PendingAddinUpdate.cs" Link="PendingAddinUpdate.cs" />
    <Compile Include="..\..\PendingUpdateWatcher.cs" Link="PendingUpdateWatcher.cs" />
  </ItemGroup>
</Project>
