              <button id="ObjectsStretchRight" label="Stretch shapes to right" onAction="ObjectsStretchRight" supertip="Stretches the selected shapes toward the right" screentip="Stretch Right" image="pptk-stretch-right" />
              <button id="ObjectsStretchTop" label="Stretch shapes to top" onAction="ObjectsStretchTop" supertip="Stretches the selected shapes upward" screentip="Stretch Up" image="pptk-stretch-top" />
              <button id="ObjectsStretchBottom" label="Stretch shapes to bottom" onAction="ObjectsStretchBottom" supertip="Stretches the selected shapes downward" screentip="Stretch Down" image="pptk-stretch-bottom" />
              <menuSeparator id="separatorObjectsStretchMenu" />
              <button id="ObjectsStretchLeftShapeRight" label="Stretch shapes to the right edge of the leftmost shape" onAction="ObjectsStretchLeftShapeRight" supertip="Stretches the selected shapes to the right edge of the leftmost shape" screentip="Stretch to Leftmost Shape" image="pptk-stretch-to-left" />
              <button id="ObjectsStretchRightShapeLeft" label="Stretch shapes to the left edge of the rightmost shape" onAction="ObjectsStretchRightShapeLeft" supertip="Stretches the selected shapes to the left edge of the rightmost shape" screentip="Stretch to Rightmost Shape" image="pptk-stretch-to-right" />
              <button id="ObjectsStretchTopShapeBottom" label="Stretch shapes to the bottom edge of the topmost shape" onAction="ObjectsStretchTopShapeBottom" supertip="Stretches the selected shapes to the bottom edge of the topmost shape" screentip="Stretch to Topmost Shape" image="pptk-stretch-to-top" />
              <button id="ObjectsStretchBottomShapeTop" label="Stretch shapes to the top edge of the bottommost shape" onAction="ObjectsStretchBottomShapeTop" supertip="Stretches the selected shapes to the top edge of the bottommost shape" screentip="Stretch to Bottommost Shape" image="pptk-stretch-to-bottom" />
            </menu>
