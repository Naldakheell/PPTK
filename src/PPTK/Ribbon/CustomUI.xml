<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="InstrumentaPowerpointToolbar" label="PPTK">
        <group id="Design" label="Design">
          <control idMso="ShapeFillColorPicker" showLabel="false" label="&#x200B;" />
          <control idMso="ShapeOutlineColorPicker" showLabel="false" label="&#x200B;" />
          <control idMso="FormatPainter" showLabel="false" />
          <button idMso="EyedropperFill" showLabel="false" size="normal" />
          <menu id="DesignMoreFormatting" label="More Formatting" image="pptk-format-more" showLabel="false" itemSize="normal" screentip="More Formatting" size="normal">
            <button id="PPTKFixSlideColors" tag="Q" label="Fix Slide Colors" image="pptk-fix-colors" onAction="PPTK_RibbonShortcut" screentip="Fix Slide Colors" supertip="Harmonizes the current slide's colors with the presentation theme" />
            <button id="PPTKCopyFormatting" tag="CTRL SHIFT C" label="Copy formatting" image="pptk-copy-format" onAction="PPTK_RibbonShortcut" screentip="Copy Formatting" supertip="Copies formatting from the selected shape" />
            <button id="PPTKPasteFormatting" tag="CTRL SHIFT V" label="Paste formatting" image="pptk-paste-format" onAction="PPTK_RibbonShortcut" screentip="Paste Formatting" supertip="Applies the copied formatting to the selected shapes" />
            <gallery idMso="ShapeStylesGallery" showLabel="false" label="&#x200B;" />
            <gallery idMso="GradientGallery" showLabel="false" label="&#x200B;" />
            <button idMso="ObjectPictureFill" showLabel="false" />
            <gallery idMso="OutlineDashesGallery" showLabel="false" label="&#x200B;" />
            <gallery idMso="OutlineWeightGallery" showLabel="false" label="&#x200B;" />
            <button idMso="EyedropperOutline" showLabel="false" />
            <toggleButton idMso="PictureCrop" showLabel="false" />
            <button idMso="PictureReset" showLabel="false" />
            <toggleButton idMso="PictureSetTransparentColor" showLabel="false" />
            <button idMso="PicturesCompress" showLabel="false" />
            <gallery idMso="PictureShapeGallery" showLabel="false" label="&#x200B;" />
          </menu>
        </group>
        <group id="Reuse" label="Reuse">
          <button id="SaveSelectedSlidesButton" label="Save selected slides" image="pptk-save-slides" showLabel="false" tag="\" onAction="PPTK_RibbonShortcut" supertip="Saves the selected slides as a new presentation" screentip="Save Selected Slides" size="normal" />
          <button id="EmailSelectedSlidesButton" label="Email Slides" image="pptk-email-slides" showLabel="false" onAction="PPTK_EmailSelectedSlides" supertip="Opens an unsent Outlook draft with the selected slides attached" screentip="Email Slides" size="normal" />
          <button id="SaveToLibraryButton" label="Save to Library" image="pptk-library-save" showLabel="false" onAction="PPTK_SaveToLibrary" supertip="Saves the selected slides as a reusable library entry" screentip="Save to Library" size="normal" />
          <button id="OpenSlideLibraryButton" label="Open Slide Library" image="pptk-library-open" showLabel="false" onAction="PPTK_OpenSlideLibrary" supertip="Opens the slide library to search and insert saved slides" screentip="Open Slide Library" size="normal" />
        </group>
        <group id="Insert" label="Insert">
          <toggleButton idMso="TextBoxInsert" showLabel="false" size="normal" />
          <control idMso="ShapesInsertGallery" showLabel="false" label="&#x200B;" size="normal" />
          <button idMso="PictureInsertFromFile" showLabel="false" size="normal" />
          <button idMso="ScreenClipping" showLabel="false" size="normal" />
          <box id="PPTKInsertRow1" boxStyle="horizontal">
            <button id="PPTKInsertT" tag="T" image="pptk-text" label="Text" showLabel="false" onAction="PPTK_RibbonShortcut" supertip="Inserts a PPTK text box and enters text editing" screentip="Text (T)" size="normal" />
            <button id="PPTKInsertN" tag="N" image="pptk-new-slide" label="New slide" showLabel="false" onAction="PPTK_RibbonShortcut" supertip="Inserts a slide after the current slide using the same layout" screentip="New slide (N)" size="normal" />
            <button id="PPTKInsertI" tag="I" image="pptk-insert-icon" label="Icon" showLabel="false" onAction="PPTK_RibbonShortcut" supertip="Opens the PowerPoint icon library" screentip="Insert Icon (I)" size="normal" />
            <button id="PPTKEncloseIcons" tag="E" image="pptk-enclose" label="Enclose" showLabel="false" onAction="PPTK_RibbonShortcut" supertip="Draws a circle around the selected icon. Press again to add a fill." screentip="Enclose Icons (E)" size="normal" />
          </box>
          <menu id="InsertMoreMenu" label="More" image="pptk-insert-more" showLabel="false" itemSize="normal" screentip="More" size="normal">
            <splitButton id="PastePngSplitButton" showLabel="false">
              <button idMso="PastePng" showLabel="false" />
              <menu id="PasteJpegMenu" itemSize="normal" supertip="Opens the tools for pasting content as JPEG" screentip="Paste as JPEG">
                <button idMso="PasteJpeg" showLabel="false" />
              </menu>
            </splitButton>
            <button idMso="DateAndTimeInsert" showLabel="false" />
            <menuSeparator id="separatorInsertTk" />
            <button id="PPTKAddRightTK" tag="CTRL 4" label="Add Right TK" image="pptk-tk-right" onAction="PPTK_RibbonShortcut" screentip="Add Right TK" supertip="Inserts an editable TK placeholder to the right of the selection" />
            <button id="PPTKAddLeftTK" tag="CTRL 7" label="Add Left TK" image="pptk-tk-left" onAction="PPTK_RibbonShortcut" screentip="Add Left TK" supertip="Inserts an editable TK placeholder to the left of the selection" />
            <button id="PPTKAddTopTK" tag="CTRL 6" label="Add Top TK" image="pptk-tk-top" onAction="PPTK_RibbonShortcut" screentip="Add Top TK" supertip="Inserts an editable TK placeholder above the selection" />
            <button id="PPTKAddBottomTK" tag="CTRL 5" label="Add Bottom TK" image="pptk-tk-bottom" onAction="PPTK_RibbonShortcut" screentip="Add Bottom TK" supertip="Inserts an editable TK placeholder below the selection" />
          </menu>
        </group>
        <group id="Text" label="Text">
          <box id="FontBox1" boxStyle="horizontal">
            <control idMso="Font" />
          </box>
          <box id="FontBox2" boxStyle="horizontal">
            <comboBox idMso="FontSize" showLabel="false" />
            <button idMso="FontSizeIncrease" showLabel="false" size="normal" />
            <button idMso="FontSizeDecrease" showLabel="false" size="normal" />
            <toggleButton idMso="Bold" showLabel="false" size="normal" />
            <toggleButton idMso="Italic" showLabel="false" size="normal" />
            <toggleButton idMso="Underline" showLabel="false" size="normal" />
          </box>
          <box id="FontBox3" boxStyle="horizontal">
            <control idMso="FontColorPicker" showLabel="false" />
            <toggleButton idMso="AlignLeft" showLabel="false" size="normal" />
            <toggleButton idMso="AlignCenter" showLabel="false" size="normal" />
            <toggleButton idMso="AlignRight" showLabel="false" size="normal" />
            <control idMso="BulletsGallery" showLabel="false" />
            <menu id="TextMoreMenu" label="More" image="pptk-text-more" showLabel="false" itemSize="normal" screentip="More" size="normal">
              <button idMso="ClearFormatting" showLabel="false" />
              <toggleButton idMso="Strikethrough" showLabel="false" />
              <control idMso="TextHighlightColorPickerLicensed" showLabel="false" />
              <control idMso="NumberingGallery" showLabel="false" />
              <button idMso="FontsReplaceFonts" showLabel="false" />
              <toggleButton idMso="AlignJustify" showLabel="false" />
              <button idMso="EyedropperFillText" showLabel="false" />
              <gallery idMso="TextAlignGallery" showLabel="false" />
              <gallery idMso="LineSpacingGalleryPowerPoint" showLabel="false" />
              <button idMso="IndentIncrease" showLabel="false" />
              <button idMso="IndentDecrease" showLabel="false" />
              <gallery idMso="TableColumnsGallery" showLabel="false" />
              <toggleButton idMso="Superscript" showLabel="false" />
              <toggleButton idMso="Subscript" showLabel="false" />
              <toggleButton idMso="Shadow" showLabel="false" />
              <gallery idMso="CharacterSpacingGallery" showLabel="false" />
              <gallery idMso="ChangeCaseGallery" showLabel="false" />
              <menu id="SpecialCharacterMenu" label="Special characters" image="pptk-special-char" showLabel="false" supertip="Inserts commonly used special characters" screentip="Special characters">
                <button idMso="SymbolInsert" showLabel="false" />
              </menu>
              <menuSeparator id="TextMoreAdvancedSeparator" />
              <button idMso="ReplaceDialog" showLabel="false" />
              <button id="PPTKPasteContentOnly" tag="CTRL SHIFT T" label="Paste content only" image="pptk-paste-text" onAction="PPTK_RibbonShortcut" screentip="Paste Content Only" supertip="Pastes clipboard text into the selection and keeps its formatting" />
              <button id="PPTKMergeText" tag=". T" label="Merge textboxes" image="pptk-merge-text" onAction="PPTK_RibbonShortcut" screentip="Merge Textboxes" supertip="Merges the selected text into the first shape" />
              <button id="PPTKRemoveMargins" tag="ALT ." label="Remove margins" image="pptk-remove-margins" onAction="PPTK_RibbonShortcut" screentip="Remove Margins" supertip="Sets the text margins of the selected shapes and table cells to zero. Alt+." />
            </menu>
          </box>
        </group>
        <group id="Align" label="Align">
          <box id="AlignDistributeBox" boxStyle="horizontal">
            <button id="ObjectsAlignLeftsButton" label="Align left" showLabel="false" image="pptk-align-left" onAction="ObjectsAlignLefts" supertip="Aligns the selected objects to the left" screentip="Align Left" size="normal" />
            <button id="ObjectsAlignCentersButton" label="Align center" showLabel="false" image="pptk-align-center" onAction="ObjectsAlignCenters" supertip="Aligns the selected objects to the center" screentip="Align Center" size="normal" />
            <button id="ObjectsAlignRightsButton" label="Align right" showLabel="false" image="pptk-align-right" onAction="ObjectsAlignRights" supertip="Aligns the selected objects to the right" screentip="Align Right" size="normal" />
          </box>
          <box id="AlignVerticalBox" boxStyle="horizontal">
            <button id="ObjectsAlignTopsButton" label="Align top" showLabel="false" image="pptk-align-top" onAction="ObjectsAlignTops" supertip="Aligns the selected objects to the top" screentip="Align Top" size="normal" />
            <button id="ObjectsAlignMiddlesButton" label="Align middle" showLabel="false" image="pptk-align-middle" onAction="ObjectsAlignMiddles" supertip="Aligns the selected objects to the middle" screentip="Align Middle" size="normal" />
            <button id="ObjectsAlignBottomsButton" label="Align bottom" showLabel="false" image="pptk-align-bottom" onAction="ObjectsAlignBottoms" supertip="Aligns the selected objects to the bottom" screentip="Align Bottom" size="normal" />
          </box>
        </group>
        <group id="Space" label="Space">
          <box id="SpaceRow1Box" boxStyle="horizontal">
            <button id="ObjectsDistributeHorizontallyButton" label="Distribute horizontally" showLabel="false" image="pptk-dist-h" onAction="ObjectsDistributeHorizontally" supertip="Evenly distributes the selected objects horizontally" screentip="Distribute Horizontally" size="normal" />
            <button id="ObjectsDistributeVerticallyButton" image="pptk-dist-v" label="Distribute vertically" showLabel="false" onAction="ObjectsDistributeVertically" supertip="Evenly distributes the selected objects vertically" screentip="Distribute Vertically" size="normal" />
          </box>
          <box id="SpaceRow2Box" boxStyle="horizontal">
            <menu id="ObjectsResizeAndSpaceEvenly" label="Resize and space evenly" image="pptk-resize-space" showLabel="false" supertip="Opens the tools for resizing and spacing the selected shapes evenly" screentip="Resize and Space Evenly" size="normal">
              <button id="ResizeAndSpaceEvenHorizontal" label="Resize and space horizontally (equal spacing)" onAction="ResizeAndSpaceEvenHorizontal" supertip="Resizes and spaces the selected shapes horizontally with equal spacing" screentip="Resize and Space Horizontally" image="pptk-resize-h" />
              <button id="ResizeAndSpaceEvenHorizontalPreserveFirst" label="Resize and space horizontally (preserve first)" onAction="ResizeAndSpaceEvenHorizontalPreserveFirst" supertip="Resizes and spaces the selected shapes horizontally while preserving the first shape" screentip="Resize and Space Horizontally (Preserve First)" image="pptk-resize-h-first" />
              <button id="ResizeAndSpaceEvenHorizontalPreserveLast" label="Resize and space horizontally (preserve last)" onAction="ResizeAndSpaceEvenHorizontalPreserveLast" supertip="Resizes and spaces the selected shapes horizontally while preserving the last shape" screentip="Resize and Space Horizontally (Preserve Last)" image="pptk-resize-h-last" />
              <button id="ResizeAndSpaceEvenVertical" label="Resize and space vertically (equal spacing)" onAction="ResizeAndSpaceEvenVertical" supertip="Resizes and spaces the selected shapes vertically with equal spacing" screentip="Resize and Space Vertically" image="pptk-resize-v" />
              <button id="ResizeAndSpaceEvenVerticalPreserveFirst" label="Resize and space vertically (preserve first)" onAction="ResizeAndSpaceEvenVerticalPreserveFirst" supertip="Resizes and spaces the selected shapes vertically while preserving the first shape" screentip="Resize and Space Vertically (Preserve First)" image="pptk-resize-v-first" />
              <button id="ResizeAndSpaceEvenVerticalPreserveLast" label="Resize and space vertically (preserve last)" onAction="ResizeAndSpaceEvenVerticalPreserveLast" supertip="Resizes and spaces the selected shapes vertically while preserving the last shape" screentip="Resize and Space Vertically (Preserve Last)" image="pptk-resize-v-last" />
            </menu>
            <menu id="SpaceGapsMenu" label="Gaps" image="pptk-gaps" showLabel="false" itemSize="normal" screentip="Gaps" size="normal">
              <splitButton id="ObjectsRemoveSpaceHorizontalSplitButton" showLabel="false">
                <button id="ObjectsRemoveSpaceHorizontal" image="pptk-gap-h-left" label="Remove horizontal gap between shapes (direction left)" showLabel="false" onAction="ObjectsRemoveSpacingHorizontal" supertip="Removes the horizontal gap between the selected shapes toward the left" screentip="Remove Horizontal Gap" />
                <menu id="ObjectsRemoveSpaceHorizontalMenu" itemSize="normal" supertip="Opens the tools for removing the horizontal gap between shapes" screentip="Remove Horizontal Gap">
                  <button id="ObjectsRemoveSpaceHorizontalRight" image="pptk-gap-h-right" label="Remove horizontal gap between shapes (direction right)" showLabel="false" onAction="ObjectsRemoveSpacingHorizontalRight" supertip="Removes the horizontal gap between the selected shapes toward the right" screentip="Remove Horizontal Gap" />
                </menu>
              </splitButton>
              <button id="ObjectsIncreaseSpacingHorizontal" image="pptk-gap-h-inc" label="Increase horizontal gap between shapes" showLabel="false" onAction="ObjectsIncreaseSpacingHorizontal" supertip="Increases the horizontal gap between the selected shapes" screentip="Increase Horizontal Gap" />
              <button id="ObjectsDecreaseSpacingHorizontal" image="pptk-gap-h-dec" label="Decrease horizontal gap between shapes" showLabel="false" onAction="ObjectsDecreaseSpacingHorizontal" supertip="Decreases the horizontal gap between the selected shapes" screentip="Decrease Horizontal Gap" />
              <splitButton id="ObjectsRemoveSpaceVerticalSplitButton" showLabel="false">
                <button id="ObjectsRemoveSpaceVertical" image="pptk-gap-v-up" label="Remove vertical gap between shapes (direction up)" showLabel="false" onAction="ObjectsRemoveSpacingVertical" supertip="Removes the vertical gap between the selected shapes upward" screentip="Remove Vertical Gap" />
                <menu id="ObjectsRemoveSpaceVerticalMenu" itemSize="normal" supertip="Opens the tools for removing the vertical gap between shapes" screentip="Remove Vertical Gap">
                  <button id="ObjectsRemoveSpaceVerticalDown" image="pptk-gap-v-down" label="Remove vertical gap between shapes (direction down)" showLabel="false" onAction="ObjectsRemoveSpacingVerticalDown" supertip="Removes the vertical gap between the selected shapes downward" screentip="Remove Vertical Gap" />
                </menu>
              </splitButton>
              <button id="ObjectsIncreaseSpacingVertical" image="pptk-gap-v-inc" label="Increase vertical gap between shapes" showLabel="false" onAction="ObjectsIncreaseSpacingVertical" supertip="Increases the vertical gap between the selected shapes" screentip="Increase Vertical Gap" />
              <button id="ObjectsDecreaseSpacingVertical" image="pptk-gap-v-dec" label="Decrease vertical gap between shapes" showLabel="false" onAction="ObjectsDecreaseSpacingVertical" supertip="Decreases the vertical gap between the selected shapes" screentip="Decrease Vertical Gap" />
            </menu>
          </box>
        </group>
        <group id="Shape" label="Shape">
          <menu id="PPTKChangeShapeMenu" label="Change shape" showLabel="false" image="pptk-change-shape" size="normal" itemSize="normal" screentip="Change shape">
            <gallery idMso="ShapeChangeShapeGallery" showLabel="false" />
            <button id="PPTKUnifyShapeType" tag="X T" label="Unify Shape Type" image="pptk-unify" onAction="PPTK_RibbonShortcut" screentip="Unify Shape Type" supertip="Changes the selected shapes to the first AutoShape type. Positions, sizes, text, and rotation stay. X then T." />
          </menu>
          <box id="ShapeRow1" boxStyle="horizontal">
            <control idMso="ShapeWidth" showLabel="false" />
            <button id="ObjectsSameWidthButton" image="pptk-same-width" label="Set same width" showLabel="false" onAction="ObjectsSameWidth" supertip="Sets all selected objects to the same width" screentip="Same Width" size="normal" />
            <button id="ObjectsSameHeightButton" image="pptk-same-height" label="Set same height" showLabel="false" onAction="ObjectsSameHeight" supertip="Sets all selected objects to the same height" screentip="Same Height" size="normal" />
            <button idMso="ObjectBringForward" showLabel="false" size="normal" />
          </box>
          <box id="ShapeRow2" boxStyle="horizontal">
            <control idMso="ShapeHeight" showLabel="false" />
            <button id="ObjectsSameHeightAndWidthButton" image="pptk-same-size" label="Set same height and width" showLabel="false" onAction="ObjectsSameHeightAndWidth" supertip="Sets all selected objects to the same height and width" screentip="Same Height and Width" size="normal" />
            <splitButton id="ObjectsSwapPositionSplitButton" size="normal" showLabel="false">
              <button id="ObjectsSwapPosition" image="pptk-swap" label="Swap position of two shapes" showLabel="false" onAction="ObjectsSwapPosition" supertip="Swaps the positions of the two selected shapes" screentip="Swap Position" />
              <menu id="ObjectsSwapPositionMenu" label="Swap position of two shapes" image="pptk-swap" showLabel="false" supertip="Opens the tools for swapping the positions of two shapes" screentip="Swap Position">
                <button id="ObjectsSwapPositionCentered" image="pptk-swap-center" label="Swap position of two shapes (centered)" showLabel="false" onAction="ObjectsSwapPositionCentered" supertip="Swaps the positions of the two selected shapes while centering them" screentip="Swap Position (Centered)" />
                <button id="PPTKSwapText" tag="CTRL /" label="Swap text" image="pptk-swap-text" onAction="PPTK_RibbonShortcut" screentip="Swap Text" supertip="Swaps the text of the two selected shapes" />
              </menu>
            </splitButton>
            <button idMso="ObjectSendBackward" showLabel="false" size="normal" />
            <menu id="ShapeMoreMenu" label="More" image="pptk-shape-more" showLabel="false" itemSize="normal" screentip="More" size="normal">
              <menu idMso="CombineShapesMenu" showLabel="false" />
              <button idMso="ObjectBringToFront" showLabel="false" />
              <button idMso="ObjectSendToBack" showLabel="false" />
              <button idMso="ObjectFlipHorizontal" showLabel="false" />
              <button idMso="ObjectFlipVertical" showLabel="false" />
              <button idMso="ObjectRotateLeft90" showLabel="false" />
              <button idMso="ObjectRotateRight90" showLabel="false" />
              <button id="ObjectsSizeToTallest" image="pptk-size-tall" label="Size to tallest" showLabel="true" onAction="ObjectsSizeToTallest" supertip="Sizes all selected objects to the tallest one" screentip="Size to Tallest" />
              <button id="ObjectsSizeShortest" image="pptk-size-short" label="Size to shortest" showLabel="true" onAction="ObjectsSizeToShortest" supertip="Sizes all selected objects to the shortest one" screentip="Size to Shortest" />
              <button id="ObjectsSizeToWidest" image="pptk-size-wide" label="Size to widest" showLabel="true" onAction="ObjectsSizeToWidest" supertip="Sizes all selected objects to the widest one" screentip="Size to Widest" />
              <button id="ObjectsSizeNarrowest" image="pptk-size-narrow" label="Size to narrowest" showLabel="true" onAction="ObjectsSizeToNarrowest" supertip="Sizes all selected objects to the narrowest one" screentip="Size to Narrowest" />
              <menuSeparator id="separatorShapeGrid" />
              <menu id="PPTKGridMenu" label="Rows and columns" image="pptk-matrix" showLabel="true" itemSize="normal" screentip="Rows and columns">
                <button id="PPTKAddRightColumn" tag="CTRL 2" label="Add Column &#x2014; Keep Bounds" image="pptk-col-add" onAction="PPTK_RibbonShortcut" screentip="Add Column &#x2014; Keep Bounds" supertip="Duplicates the rightmost column and fits every column inside the original width. Ctrl+2." />
                <button id="PPTKAddBottomRow" tag="CTRL 3" label="Add Row &#x2014; Keep Bounds" image="pptk-row-add" onAction="PPTK_RibbonShortcut" screentip="Add Row &#x2014; Keep Bounds" supertip="Duplicates the bottom row and fits every row inside the original height. Ctrl+3." />
                <button id="PPTKDeleteRightColumn" tag="ALT 2" label="Delete Column &#x2014; Keep Bounds" image="pptk-col-del" onAction="PPTK_RibbonShortcut" screentip="Delete Column &#x2014; Keep Bounds" supertip="Deletes the rightmost column and expands the rest to the original width. Alt+2." />
                <button id="PPTKDeleteBottomRow" tag="ALT 3" label="Delete Row &#x2014; Keep Bounds" image="pptk-row-del" onAction="PPTK_RibbonShortcut" screentip="Delete Row &#x2014; Keep Bounds" supertip="Deletes the bottom row and expands the rest to the original height. Alt+3." />
                <menuSeparator id="separatorGridLegacy" />
                <button id="PPTKAddRightColumnExpand" label="Add Column &#x2014; Expand" image="pptk-col-expand" onAction="PPTK_RibbonAddRightColumnExpand" screentip="Add Column &#x2014; Expand" supertip="Duplicates the rightmost column beyond the original width." />
                <button id="PPTKAddBottomRowExpand" label="Add Row &#x2014; Expand" image="pptk-row-expand" onAction="PPTK_RibbonAddBottomRowExpand" screentip="Add Row &#x2014; Expand" supertip="Duplicates the bottom row beyond the original height." />
                <button id="PPTKDeleteRightColumnShrink" label="Delete Column &#x2014; Shrink" image="pptk-col-shrink" onAction="PPTK_RibbonDeleteRightColumnShrink" screentip="Delete Column &#x2014; Shrink" supertip="Deletes the rightmost column and leaves the layout smaller." />
                <button id="PPTKDeleteBottomRowShrink" label="Delete Row &#x2014; Shrink" image="pptk-row-shrink" onAction="PPTK_RibbonDeleteBottomRowShrink" screentip="Delete Row &#x2014; Shrink" supertip="Deletes the bottom row and leaves the layout shorter." />
              </menu>
              <button id="PPTKFlipCurrentSlide" label="Flip Current Slide" image="pptk-flip-slide" showLabel="true" onAction="PPTK_RibbonFlipCurrentSlide" screentip="Flip Current Slide" supertip="Mirrors this slide horizontally and keeps text readable." />
              <button id="PPTKFlipEntirePresentation" label="Flip Entire Presentation" image="pptk-flip-deck" showLabel="true" onAction="PPTK_RibbonFlipEntirePresentation" screentip="Flip Entire Presentation" supertip="Mirrors every slide horizontally and keeps text readable. Masters and notes stay unchanged." />
