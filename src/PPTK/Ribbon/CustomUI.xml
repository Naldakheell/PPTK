            </menu>
          </box>
        </group>
        <group id="SmartAlign" label="Smart Align">
          <box id="SmartAlignRow1Box" boxStyle="horizontal">
            <button id="ObjectsArrangeShapesButton" image="pptk-arrange" label="Arrange shapes" showLabel="false" onAction="ArrangeShapes" supertip="Arranges the selected shapes into a structured layout" screentip="Arrange Shapes" size="normal" />
